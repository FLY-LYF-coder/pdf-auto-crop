# Generated diagnostics: previews, contact sheets and cropped output from
# scripts/diagnose.py, compare_algorithms.py, gui_*_screenshot.py, etc.
# These are reproducible by running the scripts, and they can contain renders
# of whatever real document was last analysed -- never commit them.
diag_out/
diag_deep/
examples/*_out/

# Test PDFs are regenerated by scripts/make_test_pdfs.py -- run it once after
# cloning, before pytest.  They are binary, reproducible, and add ~2.4 MB.
tests/fixtures/
tests/fixtures_diag/