# Generated diagnostics: previews, contact sheets and cropped output from
# scripts/diagnose.py, compare_algorithms.py, gui_*_screenshot.py, etc.
# These are reproducible by running the scripts, and they can contain renders
# of whatever real document was last analysed -- never commit them.
diag_out/
diag_deep/
examples/*_out/

# Test PDFs are regenerated by scripts/make_test_pdfs.py -- run it once after
# cloning, before pytest.  They are binary, reproducible, and add ~2.4 MB.
tests/fixtures/
tests/fixtures_diag/

# One-off measurement scripts.  The three that document the compositor's
# geometry are kept (probe_bake_fix2.py, probe_clip_rule3.py,
# probe_normalised_bake.py); the rest were steps on the way to them, and some
# of them carry absolute paths to private files.
scripts/_probe_path.py
scripts/probe_bake_clip.py
scripts/probe_bake_fidelity.py
scripts/probe_bake_fix.py
scripts/probe_bake_rotate_square.py
scripts/probe_clip_rule.py
scripts/probe_clip_rule2.py
scripts/probe_clip_scan.py
scripts/probe_clip_space.py
scripts/probe_compositor.py
scripts/probe_mupdf_origin.py
scripts/probe_offset_debug.py
